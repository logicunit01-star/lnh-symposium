# Copy to /home/symposium2027/lnh-symposium/.env (chmod 600). Never commit the real file.
NODE_ENV=production
APP_URL=https://symposium2027.lnh.edu.pk

# PostgreSQL on this server (database and user created for the symposium2027 account)
DATABASE_URL=postgresql://DBUSER:DBPASSWORD@127.0.0.1:5432/DBNAME

# Random secrets: generate each with  openssl rand -hex 32
AUTH_SECRET=
CRON_SECRET=

# First Super Admin (used only when the database is created). Use a real LNH mailbox and a strong password; change it after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Production: no demo staff logins, no dummy programme content
SEED_DEMO=0

# Sign-up codes must never be shown on screen in production
OTP_DEMO=0

# Email (from LNH IT). Until SMTP is set, emails are not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="9th LNH Symposium <symposium@lnh.edu.pk>"
# WhatsApp / SMS: eOcean xNotify, set in Admin -> WhatsApp / SMS (xNotify). Nothing needed here.

# Emails, WhatsApp and SMS are sent by the separate lnh-notifier process (PM2), not by the website
NOTIFIER=worker

# Payments: PayPro (Off / Demo / Live and its credentials) is set by the Super Admin in Admin -> Payments, stored encrypted.
# This line applies only when the admin choice is "Server settings file". Do not put PayPro credentials here.
PAYMENT_PROVIDER=manual
# Never change AUTH_SECRET after PayPro credentials, mailbox passwords or the eOcean key are saved in the admin (they are encrypted with it).

# Google Tag Manager (LNH, 23 Nov 2026; GA4 is set up inside the container). Not needed: the live address uses GTM-W2W8D2H4
# automatically. Set it only to use another container, or GTM_ID= (empty) to switch analytics off.
# GTM_ID=GTM-W2W8D2H4
