# Copy to /home/symposium2027/lnh-symposium/.env (chmod 600). Never commit the real file.
NODE_ENV=production
APP_URL=https://symposium2027.lnh.edu.pk

# PostgreSQL on this server (database and user created for the symposium2027 account)
DATABASE_URL=postgresql://DBUSER:DBPASSWORD@127.0.0.1:5432/DBNAME

# Random secrets: generate each with  openssl rand -hex 32
AUTH_SECRET=
CRON_SECRET=

# First Super Admin (used only when the database is created). Use a real LNH mailbox and a strong password; change it after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Production: no demo staff logins, no dummy programme content
SEED_DEMO=0

# Sign-up codes must never be shown on screen in production
OTP_DEMO=0

# Email (from LNH IT). Until SMTP is set, emails are not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="9th LNH Symposium <symposium@lnh.edu.pk>"
# SMS gateway (optional, from LNH IT)
SMS_API_URL=

# Payments: "manual" (bank transfer, desk marks paid) until PayPro credentials arrive, then "paypro"
PAYMENT_PROVIDER=manual
PAYPRO_BASE_URL=https://demoapi.paypro.com.pk
PAYPRO_CLIENT_ID=
PAYPRO_CLIENT_SECRET=
PAYPRO_MERCHANT_ID=
# Choose these two yourselves and give them to PayPro with the callback URL https://symposium2027.lnh.edu.pk/paypro/uis
PAYPRO_CALLBACK_USERNAME=
PAYPRO_CALLBACK_PASSWORD=
